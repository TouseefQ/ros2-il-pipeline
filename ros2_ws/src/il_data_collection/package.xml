<?xml version="1.0"?>
<package format="3">
  <name>il_data_collection</name>
  <version>0.1.0</version>
  <description>ROS2 nodes for collecting demonstration episodes during teleoperation</description>
  <maintainer email="touseefqamar1@gmail.com">Touseef Qamar</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>il_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>python3-h5py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-cv-bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
